{
	"name": "zengjin.work",
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#*": "./*"
	},
	"scripts": {
		"serve": "node .env.copy.js && node --env-file=.env server.dev.js",
		"vercel-serve": "node .env.copy.js && vercel dev --local-config vercel.json --listen 0.0.0.0:10001",
		"preview": "node ./vite.preview.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write \"api_util/**/*.js\" \"api/**/*.js\" \"*.json\" \"*.mjs\" \"*.js\"",
		"format:check": "prettier --check \"api_util/**/*.js\" \"api/**/*.js\" \"*.json\" \"*.mjs\" \"*.js\""
	},
	"dependencies": {
		"@alicloud/credentials": "^2.4.7",
		"@alicloud/dypnsapi20170525": "^2.0.0",
		"@alicloud/openapi-client": "^0.4.15",
		"@alicloud/tea-util": "^1.4.11",
		"@supabase/supabase-js": "^2.93.3",
		"@vercel/node": "^2.15.1",
		"altcha-lib": "^2.0.3",
		"dayjs": "^1.11.13",
		"express": "^4.21.2",
		"firebase-admin": "^13.0.0",
		"jsonwebtoken": "^9.0.3",
		"mysql2": "^3.6.5",
		"pg": "^8.14.1",
		"qiniu": "^7.15.1",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"tencentcloud-sdk-nodejs-tmt": "^4.1.117"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@vitejs/plugin-basic-ssl": "^2.0.0",
		"chalk": "^5.4.1",
		"nodemon": "^2.0.22",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"vercel": "^50.43.0",
		"vite": "^6.2.3",
		"vitest": "^4.1.10"
	},
	"packageManager": "bun@1.2.0"
}
