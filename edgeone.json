	"headers": [
		{
			"source": "/*",
			"headers": [
				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				},
				{
					"key": "Access-Control-Allow-Methods",
					"value": "GET,POST"
				},
				{
					"key": "Access-Control-Allow-Headers",
					"value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
				}
			]
		},
		{
			"source": "/cards/sw.js",
			"headers": [
				{
					"key": "Service-Worker-Allowed",
					"value": "/cards"
				},
				{
					"key": "Cache-Control",
					"value": "no-cache"
				}
			]
		},
		{
			"source": "/cards/index.html",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache"
				}
			]
		},
		{
			"source": "/*.glb",
			"headers": [
				{
					"key": "Content-Type",
					"value": "model/gltf-binary"
				}
			]
		},
		{
			"source": "/*.jsonl",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/x-ndjson"
				}
			]
		},
		{
			"source": "/*.task",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/octet-stream"
				}
			]
		},
		{
			"source": "/*.tflite",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/octet-stream"
				}
			]
		},
		{
			"source": "/*.bcmap",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/octet-stream"
				}
			]
		},
		{
			"source": "/*.ftl",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/octet-stream"
				}
			]
		},
		{
			"source": "/*.nes",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/octet-stream"
				}
			]
		},
		{
			"source": "/*.mjs",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/javascript; charset=utf-8"
				}
			]
		},
		{
			"source": "/*.wasm",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/wasm"
				}
			]
		},
		{
			"source": "/*.woff2",
			"headers": [
				{
					"key": "Content-Type",
					"value": "font/woff2"
				}
			]
		}
	],
	"schedules": [
		{
			"name": "supabase-keepalive",
			"cron": "0 3 * * *",
			"path": "/api/base/keepalive/supabase",
			"method": "GET",
			"timezone": "Asia/Shanghai"
		}
	]
}
