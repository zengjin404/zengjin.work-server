{
	"buildCommand": "bun scripts/prepare-edgeone.mjs",
	"installCommand": "bun install --frozen-lockfile --production",
	"outputDirectory": "edgeone-dist",
	"nodeVersion": "20.18.0",
	"cloudFunctions": {
		"nodejs": {
			"maxDuration": 120
		}
	},
	"redirects": [
		{
			"source": "/index",
			"destination": "/",
			"statusCode": 301
		},
		{
			"source": "/index/",
			"destination": "/",
			"statusCode": 301
		}
	],
	"rewrites": [
