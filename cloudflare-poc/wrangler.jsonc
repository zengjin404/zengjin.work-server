{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "zengjin-cf-poc",
	"main": "./src/index.js",
	"compatibility_date": "2026-11-27",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
	},
}
