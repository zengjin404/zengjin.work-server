# EdgeOne Makers 环境变量清单（仅键名，不含值）
# 使用方式：控制台 → 项目 → 环境变量 → 批量导入时按需填写值。
# 严禁把真实值提交到 Git、写入 edgeone.json 或打印到构建日志。

NODE_ENV=production
APP_ENV=production

# 主库选择：supabase 或 neon
DB=supabase
DB_POOL_MAX=3

# Supabase（主库/备库）
DB_SUPABASE_HOST=
DB_SUPABASE_PORT=5432
DB_SUPABASE_NAME=
DB_SUPABASE_USER=
DB_SUPABASE_PASSWORD=

# Neon（备库/主库）
DB_NEON_HOST=
DB_NEON_PORT=5432
DB_NEON_NAME=
DB_NEON_USER=
DB_NEON_PASSWORD=

# 认证与加密
JWT_SECRET=
CRYPTO_SECRET=

# 定时任务（EdgeOne schedules 不能注入自定义头；未验证前不要启用 EdgeOne 备份）
CRON_SECRET=

# Cookie：EdgeOne 同源部署建议 Lax；Secure 由 x-forwarded-proto 自动判断
COOKIE_SAMESITE=Lax
# 1=保活任务必须带 CRON_SECRET；0/不设置=保持匿名（与现有 Vercel Cron 一致）
KEEPALIVE_REQUIRE_AUTH=0

# 七牛云
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=

# 腾讯云
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_PROJECT_ID=

# 火山引擎
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=

# 搜索
SEARCH_API_KEY=
# 兼容别名
TAVILY_API_KEY=

# 阿里云短信
ALICLOUD_ACCESS_KEY_ID=
ALICLOUD_ACCESS_KEY_SECRET=
ALICLOUD_SMS_SIGN_NAME=
ALICLOUD_SMS_TEMPLATE_CODE=
ALICLOUD_SMS_TEMPLATE_PARAM=
ALICLOUD_SMS_ENDPOINT=

# 分享 Worker
SHARE_WORKER_URL=
SHARE_ADMIN_WORKER_URL=
SHARE_ADMIN_SECRET=

# Firebase 已封版；如需保留，注意 FIREBASE_PRIVATE_KEY 可能超过 1000 字节限制
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
