# EdgeOne Makers 环境变量清单（以实际后端运行代码为准；本文件入库，仅含键名、默认值与说明）
# ⚠️ 严禁将真实密码、数据库凭据、API Key 或 Token 写入本文件并提交到 Git！

# 运行环境（api/_doc.js 使用 NODE_ENV；api_util/db.js 日志使用 APP_ENV）
NODE_ENV=production
APP_ENV=production

# 数据库主备配置（api_util/db.js、api/_base/backup.js）
# DB：当前主库标识（supabase 或 neon）
DB=supabase
# DB_POOL_MAX：可选，代码默认 10；Serverless 环境建议设为 3 控制单实例连接数
DB_POOL_MAX=3

# Supabase 数据库（必须使用独立测试库，禁止把 .env.development 生产库凭据用于 POC 写入测试）
DB_SUPABASE_HOST=
# 可选，代码默认 5432
DB_SUPABASE_PORT=5432
# 可选，代码默认 postgres
DB_SUPABASE_NAME=postgres
DB_SUPABASE_USER=
DB_SUPABASE_PASSWORD=

# Neon 数据库（备库/主库）
DB_NEON_HOST=
# 可选，代码默认 5432
DB_NEON_PORT=5432
# 可选，代码默认 postgres；Neon 常用库名示例为 neondb
DB_NEON_NAME=
DB_NEON_USER=
DB_NEON_PASSWORD=

# 认证与加密（jwt.js、crypto.js、user.js、jndv_gate.js）
JWT_SECRET=
CRYPTO_SECRET=

# 定时任务密钥（cron_auth.js、backup.js）
# 说明：当前 EdgeOne POC 不迁移备份 Cron（edgeone.json 仅配置 keepalive），不需要为了 Keepalive 填写本项；
# 若需允许通过 CRON_SECRET 手动/定时触发 /api/base/backup，请配置独立随机密钥。
CRON_SECRET=

# Cookie 策略（api_util/cookie.js，可选）
# 不设置时，HTTPS 请求默认使用 SameSite=None; Secure，严格保持原有 Vercel 生产行为；
# 仅在确认全站完全同源且需显式更改策略时才手动设置，不得擅自更改默认行为。
# COOKIE_SAMESITE=
# COOKIE_SECURE=

# Keepalive 鉴权开关（api/_base/keepalive.js，可选）
# 不设置或非 1 时保持原有匿名 Keepalive 行为；仅设为 1 时才强制要求 CRON_SECRET。
# KEEPALIVE_REQUIRE_AUTH=

# 七牛云存储（api_util/_storage_provider.js）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=

# 腾讯云翻译（api/_base/translate.js）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_PROJECT_ID=

# 火山引擎翻译（api/_base/translate.js）
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=

# AI 联网搜索（api/_base/ai.js，可选；未配时仅跳过 Tavily 兜底搜索）
SEARCH_API_KEY=

# 阿里云短信认证（api_util/sms_alicloud.js）
ALICLOUD_ACCESS_KEY_ID=
ALICLOUD_ACCESS_KEY_SECRET=
# 以下四项在代码内均有默认值，仅在需覆盖默认配置时填写（非必填）：
# ALICLOUD_SMS_SIGN_NAME=速通互联验证服务
# ALICLOUD_SMS_TEMPLATE_CODE=100001
# ALICLOUD_SMS_TEMPLATE_PARAM={"code":"##code##","min":"10"}
# ALICLOUD_SMS_ENDPOINT=dypnsapi.aliyuncs.com

# 分享 Worker（api/_share.js）
# SHARE_WORKER_URL 可选，代码默认 https://share.zengjin.work
# SHARE_WORKER_URL=https://share.zengjin.work
SHARE_ADMIN_SECRET=

# 旧版 Turnstile 备份人机验证（api/_base/user.js，可选；当前默认走 ALTCHA，通常无需填写）
# TURNSTILE_SECRET_KEY=

# 文档公开地址覆盖（api/_doc.js，可选；不设置时自动按请求可信 Host 与协议推导）
# PUBLIC_API_URL=

# 说明：Firebase（FIREBASE_WEB_API_KEY / FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY）
# 已封版停用，且私钥长度可能超过 EdgeOne 单值 1000 字节限制，不作为 EdgeOne 迁移变量。
